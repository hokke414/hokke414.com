---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/content';

interface Props {
  title: string;
  description: string;
  date: Date;
  endDate?: Date;
  type: 'community' | 'event' | 'oss' | 'hackathon' | 'other';
  organization?: string;
  role?: string;
  links?: { label: string; url: string }[];
  image?: string;
}

const { title, description, date, endDate, type, organization, role, links = [], image } = Astro.props;

const typeLabel: Record<Props['type'], string> = {
  community: 'コミュニティ',
  event: 'イベント',
  oss: 'OSS',
  hackathon: 'ハッカソン',
  other: 'その他',
};

const periodStr = endDate
  ? `${formatDate(date)} – ${formatDate(endDate)}`
  : formatDate(date);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  pubDate={date}
  ogImage={image}
>
  <article class="post-wrap">
    <div class="container">
      <header class="post-header">
        <img class="hero-image" src={image || '/noimg.png'} alt="" />
        <div class="post-meta">
          <span class:list={['type-badge', `type-${type}`]}>{typeLabel[type]}</span>
          {organization && <span class="org-tag">{organization}</span>}
          <time datetime={date.toISOString()}>{periodStr}</time>
        </div>
        <h1>{title}</h1>
        {role && <p class="role">{role}</p>}
        <p class="lead">{description}</p>
        {links.length > 0 && (
          <div class="link-list">
            {links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="ext-link">
                {l.label} ↗
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <a href="/activities" class="back-link">← Activities一覧へ</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-wrap {
    padding-top: 64px;
    padding-bottom: 5rem;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .post-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--canvas-subtle);
    margin-bottom: 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .type-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 2em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .type-community { background: #dbeafe; color: #1e40af; }
  .type-event     { background: #fce7f3; color: #9d174d; }
  .type-oss       { background: #dcfce7; color: #14532d; }
  .type-hackathon { background: #fef9c3; color: #713f12; }
  .type-other     { background: var(--canvas-subtle); color: var(--fg-muted); }

  :root.dark .type-community { background: #1c2e4a; color: #93c5fd; }
  :root.dark .type-event     { background: #3b1728; color: #f9a8d4; }
  :root.dark .type-oss       { background: #14291e; color: #86efac; }
  :root.dark .type-hackathon { background: #2d2013; color: #fde047; }

  .org-tag {
    font-size: 0.75rem;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 2em;
    padding: 0.1rem 0.55rem;
  }

  .post-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .role {
    font-size: 0.9375rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .lead {
    color: var(--fg-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ext-link {
    font-size: 0.9375rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* Prose styles */
  .prose { font-size: 1rem; line-height: 1.85; }
  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.01em;
  }
  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(p) { margin: 1rem 0; }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--canvas-subtle);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    background: var(--canvas-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.9rem;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--border);
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    color: var(--fg-muted);
  }
  .prose :global(a) { color: var(--accent); text-decoration: underline; }
  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 1.5rem auto;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9375rem; }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose :global(th) { background: var(--canvas-subtle); font-weight: 600; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
  }
</style>
