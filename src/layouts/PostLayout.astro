---
import BaseLayout from './BaseLayout.astro';
import ArticleJsonLd from '../components/ArticleJsonLd.astro';
import { formatDate } from '../utils/content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
}

const { title, description, pubDate, updatedDate, tags = [], category } = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article" pubDate={pubDate}>
  <ArticleJsonLd
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    tags={tags}
  />
  <article class="post-wrap">
    <div class="container">
      <header class="post-header">
        <div class="post-meta">
          {category && <span class="category">{category}</span>}
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <span class="updated">更新: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
          )}
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        {tags.length > 0 && (
          <div class="tag-list">
            {tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <a href="/blog" class="back-link">← ブログ一覧へ</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-wrap {
    padding-top: 64px;
    padding-bottom: 5rem;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .post-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .category {
    background: var(--canvas-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.15rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .post-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .lead {
    color: var(--fg-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Prose styles */
  .prose { font-size: 1rem; line-height: 1.85; }
  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.01em;
  }
  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(p) { margin: 1rem 0; }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--canvas-subtle);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    background: var(--canvas-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.9rem;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--border);
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    color: var(--fg-muted);
  }
  .prose :global(a) { color: var(--accent); text-decoration: underline; }
  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 1.5rem auto;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9375rem; }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose :global(th) { background: var(--canvas-subtle); font-weight: 600; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
  }
</style>
