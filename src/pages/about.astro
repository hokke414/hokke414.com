---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { skills } from '../data/resume';
---

<BaseLayout
  title="About"
  description="hokke414のプロフィール。情報系の大学生エンジニアとしての自己紹介、スキル、将来目標を掲載しています。"
>
  <div class="page-wrap">
    <div class="container">
      <div class="page-header">
        <h1>About</h1>
        <p>Ryo Okudera (hokke414) のプロフィールです。</p>
      </div>

      <div class="content">
        <!-- Profile -->
        <section aria-labelledby="profile-title">
          <h2 id="profile-title" class="section-title">Profile</h2>
          <div class="profile-grid">
            <div class="avatar">
              <img src="/avatar.png" alt="hokke414 のプロフィール画像" width="72" height="72" loading="lazy" decoding="async" />
            </div>
            <div class="profile-body">
              <h3 class="profile-name">Ryo Okudera <span class="profile-handle">hokke414</span></h3>
              <p class="profile-role">Computer Science Student / Web Developer</p>
              <div class="profile-bio">
                <p>
                  情報系の大学に在籍している大学生です。<br>Web開発やAI・機械学習を中心に学習しています。
                </p>
                <p>
                  個人開発やコミュニティ活動を通じて実践的なスキルを磨きながら、将来はエンジニアとして社会に貢献したいと考えています。
                </p>
              </div>
              <SocialLinks size="sm" />
            </div>
          </div>
        </section>

        <!-- Interests -->
        <section aria-labelledby="interests-title">
          <h2 id="interests-title" class="section-title">興味分野</h2>
          <ul class="interest-list">
            <li>Web フロントエンド開発（Astro, React, TypeScript）</li>
            <li>個人プロダクト開発・OSS 活動</li>
            <li>コミュニティの参加と活動</li>
          </ul>
        </section>

        <!-- Learning -->
        <section aria-labelledby="learning-title">
          <h2 id="learning-title" class="section-title">学習中の技術</h2>
          <ul class="interest-list">
            <li>Webサイト構築、フロントエンド開発</li>
            <li>クラウドインフラ（Vercel/Azure）</li>
            <li>機械学習(AI)、Python</li>
          </ul>
        </section>

        <!-- Skills -->
        <section aria-labelledby="skills-title">
          <h2 id="skills-title" class="section-title">Skills</h2>
          <div class="skills-grid">
            {Object.entries(skills).map(([cat, items]) => (
              <div class="skill-group">
                <h3 class="skill-cat">{cat}</h3>
                <ul>
                  {items.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- Goals -->
        <section aria-labelledby="goals-title">
          <h2 id="goals-title" class="section-title">将来目標</h2>
          <p class="goal-text">
            AIエンジニアとして、人々の生活や働き方を豊かにするプロダクトを作り続けることが目標です。
            技術だけでなくコミュニティへの貢献も大切にし、オープンな文化を育てていきたいと思っています。
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-bottom: 5rem;
  }

  /* Profile */
  .profile-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--border);
    background: var(--canvas-subtle);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .profile-body { display: flex; flex-direction: column; gap: 0.6rem; }

  .profile-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .profile-handle {
    font-size: 0.85em;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .profile-role { font-size: 0.9375rem; color: var(--fg-muted); margin-top: -0.3rem; }

  .profile-bio {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  /* Interests */
  .interest-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .interest-list li {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    padding-left: 1rem;
    position: relative;
  }

  .interest-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.7rem;
    top: 0.2em;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .skill-group {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.875rem 1rem;
    background: var(--canvas-subtle);
  }

  .skill-cat {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-bottom: 0.6rem;
  }

  .skill-group ul { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
  .skill-group li { font-size: 0.875rem; color: var(--fg); }

  /* Goals */
  .goal-text {
    color: var(--fg-muted);
    line-height: 1.8;
    max-width: 640px;
  }

  @media (max-width: 480px) {
    .profile-grid { grid-template-columns: 1fr; }
    .avatar { width: 56px; height: 56px; }
  }
</style>
