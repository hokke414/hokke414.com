---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={d.title} description={d.description}>
  <article class="page-wrap">
    <div class="container">
      <header class="proj-header">
        <a href="/projects" class="back">← Projects</a>
        <div class="proj-meta">
          <span class:list={['status-badge', `status-${d.status}`]}>
            {d.status === 'active' ? 'Active' : d.status === 'wip' ? 'WIP' : 'Archived'}
          </span>
          <time>{formatDate(d.startDate)}{d.endDate ? ` – ${formatDate(d.endDate)}` : ' – 現在'}</time>
        </div>
        <h1>{d.title}</h1>
        <p class="proj-desc">{d.description}</p>
        <div class="proj-tags">
          {d.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="proj-links">
          {d.github && <a href={d.github} target="_blank" rel="noopener noreferrer" class="link-btn">GitHub ↗</a>}
          {d.demo   && <a href={d.demo}   target="_blank" rel="noopener noreferrer" class="link-btn link-primary">Demo ↗</a>}
        </div>
      </header>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .page-wrap { padding-top: 64px; padding-bottom: 5rem; }

  .container { max-width: 720px; margin: 0 auto; padding: 0 1.5rem; }

  .back {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-top: 2rem;
    margin-bottom: 1.5rem;
  }

  .proj-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .proj-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 2em;
    text-transform: uppercase;
  }

  .status-active { background: #dcfce7; color: #14532d; }
  .status-wip    { background: #fef9c3; color: #713f12; }
  .status-archived { background: var(--canvas-subtle); color: var(--fg-muted); border: 1px solid var(--border); }
  :root.dark .status-active { background: #14291e; color: #86efac; }
  :root.dark .status-wip    { background: #2d2013; color: #fde047; }

  .proj-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .proj-desc { color: var(--fg-muted); font-size: 1.0625rem; line-height: 1.7; }

  .proj-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .proj-links { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .link-btn {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition);
  }

  .link-btn:hover { color: var(--fg); border-color: var(--fg-muted); text-decoration: none; }

  .link-primary { color: var(--accent); border-color: var(--accent); }
  .link-primary:hover { background: var(--accent-subtle); }

  /* Prose - same as PostLayout */
  .prose { font-size: 1rem; line-height: 1.85; }
  .prose :global(h2) { font-size: 1.375rem; font-weight: 700; margin: 2.5rem 0 0.75rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
  .prose :global(h3) { font-size: 1.125rem; font-weight: 700; margin: 2rem 0 0.5rem; }
  .prose :global(p) { margin: 1rem 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin: 1rem 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.875em; background: var(--canvas-subtle); border: 1px solid var(--border); border-radius: 4px; padding: 0.1em 0.35em; }
  .prose :global(pre) { background: var(--canvas-inset); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; overflow-x: auto; margin: 1.5rem 0; }
  .prose :global(pre code) { background: none; border: none; padding: 0; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; }
</style>
