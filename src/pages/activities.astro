---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { getAllActivities } from '../utils/content';

const activities = await getAllActivities();
---

<BaseLayout
  title="Activities"
  description="hokke414のコミュニティ活動一覧。イベント参加・登壇・勉強会・ハッカソンなどの活動記録です。"
>
  <div class="page-wrap">
    <div class="container">
      <div class="page-header">
        <h1>Activities</h1>
        <p>イベント・コミュニティ活動への参加・登壇・運営などの記録です。</p>
      </div>

      {activities.length === 0 ? (
        <p class="empty">活動記録がまだありません。</p>
      ) : (
        <div class="grid">
          {activities.map((a) => (
            <div class="grid-item">
              <ActivityCard
                href={`/activities/${a.id}`}
                title={a.data.title}
                description={a.data.description}
                date={a.data.date}
                endDate={a.data.endDate}
                type={a.data.type}
                organization={a.data.organization}
                role={a.data.role}
                links={a.data.links}
                image={a.data.image}
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    padding-bottom: 5rem;
  }

  .grid-item {
    display: flex;
  }

  .grid-item > :global(.card) {
    flex: 1;
  }

  .empty { color: var(--fg-muted); padding: 3rem 0; }
</style>
