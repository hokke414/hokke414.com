---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const features = [
  {
    icon: '🎨',
    title: 'デザインから制作まで',
    body: 'お客様のブランドや目的に合わせたオリジナルデザインでサイトを制作。テンプレートの使い回しではなく、あなたのためのWebを作ります。',
  },
  {
    icon: '🔄',
    title: '更新・運用もおまかせ',
    body: '情報の更新、画像差し替え、ページ追加など、運用にかかる作業をまとめて代行。「更新したいけど時間がない」を解消します。',
  },
  {
    icon: '📱',
    title: 'スマホ対応・高速表示',
    body: 'スマートフォンでも快適に閲覧できるレスポンシブデザインを標準対応。SEOにも有利な高速サイトを提供します。',
  },
  {
    icon: '🔒',
    title: 'セキュリティ・SSL対応',
    body: '常時HTTPS化はもちろん、定期的なバックアップや脆弱性チェックも対応。安全なサイト運営をサポートします。',
  },
  {
    icon: '📊',
    title: 'アクセス解析レポート',
    body: '月次でアクセス状況を共有。どんなユーザーが来ているか、何が効果的かを一緒に確認しながら改善につなげます。',
  },
  {
    icon: '💬',
    title: '気軽に相談できる窓口',
    body: '「こんな機能を追加したい」「デザインを変えたい」など、気軽に相談できる担当者が対応。スピーディーに動きます。',
  },
];

const faq = [
  {
    q: '初期費用には何が含まれますか？',
    a: '初期費用30,000円には、ヒアリング・デザイン・制作・公開までの全工程が含まれます。別途追加費用が発生する場合は、事前にご説明します。',
  },
  {
    q: '制作実績への掲載とはどういうことですか？',
    a: '制作したサイトをhokke414のポートフォリオ等に掲載させていただく許可をいただいた場合、5,000円分のクレジットをお渡しします。クレジットは月額料金への充当や、追加カスタマイズ費用に使用できます。',
  },
  {
    q: '契約期間の縛りはありますか？',
    a: '縛りはありません。月単位でのご契約となりますので、不要になった場合はいつでも解約できます。',
  },
  {
    q: 'どんな業種・規模でも対応できますか？',
    a: '個人事業主や小規模ビジネスを主な対象としています。まずはご相談いただければ、対応可否をお伝えします。',
  },
  {
    q: '今あるサイトのリニューアルも依頼できますか？',
    a: 'もちろんです。現状の課題をヒアリングしたうえで、最適なプランをご提案します。',
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Web制作・運用代行 初期費用3万・月額5000円 – hokke414</title>
    <meta name="description" content="ホームページ制作＋運用まるごとおまかせ。初期費用30,000円・月額5,000円。個人・小規模事業者向けのWeb制作・運用代行サービス。更新作業・保守・相談対応すべておまかせ。" />
    <link rel="canonical" href="https://hokke414.com/services/web/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="nav">
      <a href="/services/" class="nav-back">← サービス一覧</a>
      <a href="/contact" class="nav-cta">無料相談する</a>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <p class="hero-eyebrow">WEB制作・運用代行</p>
        <h1 class="hero-title">
          作るだけじゃない。<br />
          <span class="hero-accent">ずっと一緒に育てる</span><br />
          Webサービス。
        </h1>
        <p class="hero-sub">
          ホームページの制作から更新・保守まで、まるごとおまかせ。<br />
          <strong>初期費用30,000円・月額5,000円</strong>で、本格的なWeb運用を実現します。
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">無料で相談してみる</a>
          <a href="#features" class="btn btn-ghost">サービス詳細を見る</a>
        </div>
        <p class="hero-note">※ 制作実績への掲載にご協力いただける場合、5,000円分のクレジットをプレゼント。</p>
      </div>
    </section>

    <!-- Price highlight -->
    <section class="price-band">
      <div class="price-inner">
        <div class="price-cards">
          <div class="price-card">
            <p class="price-label">初期費用（制作込み）</p>
            <p class="price-amount"><span class="price-yen">¥</span>30,000<span class="price-tax">（税込）</span></p>
            <ul class="price-includes">
              <li>✓ ヒアリング・要件整理</li>
              <li>✓ デザイン・コーディング</li>
              <li>✓ 公開設定・ドメイン取得支援</li>
              <li>✓ 修正対応（複数回）</li>
            </ul>
          </div>
          <div class="price-card price-card--monthly">
            <p class="price-label">月額運用プラン</p>
            <p class="price-amount"><span class="price-yen">¥</span>5,000<span class="price-tax">/月（税込）</span></p>
            <ul class="price-includes">
              <li>✓ 更新・コンテンツ修正</li>
              <li>✓ サーバー・ドメイン管理</li>
              <li>✓ セキュリティ対応</li>
              <li>✓ 月次レポート</li>
              <li>✓ 相談・サポート対応</li>
            </ul>
          </div>
          <div class="price-card price-card--credit">
            <p class="price-label">制作実績掲載協力特典</p>
            <p class="price-amount price-amount--credit"><span class="price-yen">¥</span>5,000<span class="price-tax">クレジット</span></p>
            <p class="price-credit-note">制作したサイトをポートフォリオに掲載させていただける場合、5,000円分のクレジットをプレゼント。月額料金の充当や追加カスタマイズ費用に使用できます。</p>
          </div>
        </div>
        <div class="price-message">
          <h2>「更新できてないサイト」<br />に心当たりはありませんか？</h2>
          <p>せっかく作ったホームページも、情報が古いままでは逆効果です。でも更新する時間も、やり方もわからない——そんな悩みを、まるごと引き受けます。</p>
          <p>制作だけでなく、作った後の運用まで伴走するのが、このサービスのいちばんの強みです。<strong>縛りなし・月単位の契約</strong>なので、まずは気軽にお試しください。</p>
          <a href="/contact" class="price-cta">まずは無料相談 →</a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features" id="features">
      <div class="section-inner">
        <p class="section-eyebrow">FEATURES</p>
        <h2 class="section-title">含まれるサービス内容</h2>
        <div class="features-grid">
          {features.map((f) => (
            <div class="feature-card">
              <span class="feature-icon">{f.icon}</span>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-body">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Flow -->
    <section class="flow">
      <div class="section-inner">
        <p class="section-eyebrow">FLOW</p>
        <h2 class="section-title">ご依頼の流れ</h2>
        <ol class="flow-list">
          <li class="flow-item">
            <span class="flow-num">01</span>
            <div>
              <h3>無料相談・ヒアリング</h3>
              <p>お問い合わせフォームまたはSNSからご連絡ください。目的・ご予算・スケジュールなどをヒアリングします。</p>
            </div>
          </li>
          <li class="flow-item">
            <span class="flow-num">02</span>
            <div>
              <h3>お見積もり・プランご提案</h3>
              <p>ヒアリング内容をもとに、制作費・月額費用・スケジュールをご提案します。</p>
            </div>
          </li>
          <li class="flow-item">
            <span class="flow-num">03</span>
            <div>
              <h3>制作・デザイン</h3>
              <p>デザイン案をご確認いただきながら制作を進めます。修正対応もしっかり行います。</p>
            </div>
          </li>
          <li class="flow-item">
            <span class="flow-num">04</span>
            <div>
              <h3>公開・運用スタート</h3>
              <p>サイト公開後、月額プランで継続サポート。更新や相談はいつでもどうぞ。</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="section-inner">
        <p class="section-eyebrow">FAQ</p>
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-inner">
        <h2>まずは気軽にご相談ください</h2>
        <p>「どんなサイトが必要か分からない」「予算が合うか不安」など、どんな段階でも大丈夫です。相談は無料です。</p>
        <a href="/contact" class="btn btn-primary btn-lg">無料で相談してみる →</a>
      </div>
    </section>

    <footer class="footer">
      <p>© 2025 hokke414 &nbsp;|&nbsp; <a href="/">ポートフォリオ</a> &nbsp;|&nbsp; <a href="/services/">サービス一覧</a></p>
    </footer>

    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #fafaf8;
    color: #1a1a1a;
    line-height: 1.75;
  }

  /* Nav */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: #fff;
    border-bottom: 1px solid #e8e4de;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-back {
    font-size: 0.875rem;
    color: #555;
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-back:hover { color: #2d5a3d; }

  .nav-cta {
    background: #2d5a3d;
    color: #fff;
    padding: 0.45rem 1.1rem;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nav-cta:hover { background: #1e3f2a; }

  /* Hero */
  .hero {
    background: linear-gradient(150deg, #0f2517 0%, #1e3f2a 50%, #2d5a3d 100%);
    color: #fff;
    padding: 6rem 1.5rem 5rem;
  }

  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #86efac;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 1.5rem;
  }

  .hero-accent {
    color: #86efac;
  }

  .hero-sub {
    font-size: 1.0625rem;
    color: #bbf7d0;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .hero-sub strong {
    color: #fff;
    font-size: 1.125rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-note {
    font-size: 0.78rem;
    color: #86efac;
    opacity: 0.75;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #fff;
    color: #1e3f2a;
  }

  .btn-primary:hover {
    background: #f0fdf4;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  .btn-ghost {
    border: 1.5px solid rgba(255,255,255,0.4);
    color: #fff;
  }

  .btn-ghost:hover {
    background: rgba(255,255,255,0.1);
  }

  .btn-lg {
    padding: 0.875rem 2.25rem;
    font-size: 1rem;
  }

  /* Price band */
  .price-band {
    background: #fff;
    border-bottom: 1px solid #e8e4de;
    padding: 4rem 1.5rem;
  }

  .price-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .price-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .price-card {
    background: #f0fdf4;
    border: 2px solid #86efac;
    border-radius: 20px;
    padding: 1.75rem;
    text-align: center;
  }

  .price-card--monthly {
    background: #f0fdf4;
    border-color: #4ade80;
  }

  .price-card--credit {
    background: #fffbeb;
    border-color: #fbbf24;
  }

  .price-label {
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #2d5a3d;
    margin-bottom: 0.75rem;
  }

  .price-card--credit .price-label {
    color: #92400e;
  }

  .price-amount {
    font-size: 2rem;
    font-weight: 900;
    color: #1e3f2a;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .price-amount--credit {
    color: #92400e;
  }

  .price-yen {
    font-size: 1.125rem;
    vertical-align: super;
  }

  .price-tax {
    font-size: 0.8rem;
    font-weight: 500;
    color: #555;
  }

  .price-includes {
    list-style: none;
    text-align: left;
    font-size: 0.8375rem;
    color: #2d5a3d;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .price-credit-note {
    font-size: 0.8125rem;
    color: #78350f;
    text-align: left;
    line-height: 1.7;
  }

  .price-cta {
    display: inline-block;
    background: #2d5a3d;
    color: #fff;
    padding: 0.6rem 1.5rem;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
    margin-top: 1rem;
  }

  .price-cta:hover { background: #1e3f2a; }

  .price-message {
    background: #f5f3ef;
    border-radius: 16px;
    padding: 2rem;
  }

  .price-message h2 {
    font-size: clamp(1.1rem, 2.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .price-message p {
    font-size: 0.9375rem;
    color: #444;
    margin-bottom: 0.75rem;
  }

  /* Section common */
  .section-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem;
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #2d5a3d;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  /* Features */
  .features {
    background: #fafaf8;
    border-top: 1px solid #e8e4de;
    border-bottom: 1px solid #e8e4de;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .feature-card {
    background: #fff;
    border: 1px solid #e8e4de;
    border-radius: 14px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }

  .feature-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  }

  .feature-icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .feature-title {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }

  .feature-body {
    font-size: 0.8375rem;
    color: #555;
    line-height: 1.75;
  }

  /* Flow */
  .flow {
    background: #fff;
  }

  .flow-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
  }

  .flow-list::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, #86efac, #2d5a3d);
    border-radius: 2px;
  }

  .flow-item {
    display: flex;
    gap: 1.5rem;
    padding-left: 0.5rem;
    position: relative;
  }

  .flow-num {
    min-width: 40px;
    height: 40px;
    background: #2d5a3d;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .flow-item h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: #1a1a1a;
  }

  .flow-item p {
    font-size: 0.875rem;
    color: #555;
  }

  /* FAQ */
  .faq {
    background: #f5f3ef;
    border-top: 1px solid #e8e4de;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: #fff;
    border: 1px solid #e8e4de;
    border-radius: 12px;
    overflow: hidden;
  }

  .faq-q {
    padding: 1.1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #1a1a1a;
    transition: background 0.15s;
  }

  .faq-q::-webkit-details-marker { display: none; }

  .faq-q::after {
    content: '+';
    font-size: 1.25rem;
    color: #2d5a3d;
    transition: transform 0.2s;
  }

  details[open] .faq-q::after {
    transform: rotate(45deg);
  }

  .faq-q:hover { background: #f9f9f9; }

  .faq-a {
    padding: 0 1.25rem 1.1rem;
    font-size: 0.875rem;
    color: #555;
    line-height: 1.75;
  }

  /* CTA section */
  .cta-section {
    background: linear-gradient(150deg, #0f2517 0%, #2d5a3d 100%);
    color: #fff;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-inner h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .cta-inner p {
    font-size: 0.9375rem;
    color: #bbf7d0;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  /* Footer */
  .footer {
    background: #fff;
    text-align: center;
    padding: 2rem;
    font-size: 0.8rem;
    color: #888;
    border-top: 1px solid #e8e4de;
  }

  .footer a {
    color: #2d5a3d;
    text-decoration: none;
  }

  .footer a:hover { text-decoration: underline; }

  /* Responsive */
  @media (max-width: 800px) {
    .price-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .nav { padding: 0.875rem 1rem; }
    .flow-list::before { left: 18px; }

    .hero-actions {
      flex-direction: column;
    }

