---
import BaseLayout from '../layouts/BaseLayout.astro';
import { templates } from '../data/templates';
---

<BaseLayout
  title="Notion テンプレート"
  description="hokke414が紹介・配布しているNotionテンプレートの一覧です。"
  noindex={true}
>
  <div class="page-wrap">
    <div class="container">
      <div class="page-header">
        <h1>Notion テンプレート</h1>
        <p>Instagramで紹介したNotionテンプレートを配布しています。</p>
      </div>

      {templates.length === 0 ? (
        <p class="empty">テンプレートを準備中です。しばらくお待ちください。</p>
      ) : (
        <div class="grid">
          {templates.map((t) => (
            <article class="card">
              <div class="card-body">
                <h2 class="card-title">{t.title}</h2>
                <p class="card-desc">{t.description}</p>
              </div>
              <div class="card-footer">
                <a
                  href={t.instagramUrl}
                  class="btn btn-secondary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img src="/sns/instagram.png" alt="" width="16" height="16" class="btn-icon" />
                  Instagramの投稿を見る
                </a>
                <a
                  href={t.templateUrl}
                  class="btn btn-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  テンプレートを使う →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
    padding-bottom: 5rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .card-body {
    flex: 1;
    padding: 1.5rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .card-footer {
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    text-decoration: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }

  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: 1px solid var(--accent);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }

  .btn-secondary {
    background: var(--canvas);
    color: var(--fg-muted);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
    background: var(--canvas-subtle);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .empty {
    color: var(--fg-muted);
    padding: 3rem 0;
    padding-bottom: 5rem;
  }
</style>
