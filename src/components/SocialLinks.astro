---
import { socials } from '../data/resume';

interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;

const iconSrc: Record<string, string> = {
  github:    '/sns/github.png',
  zenn:      '/sns/zenn.jpg',
  x:         '/sns/x.jpg',
  instagram: '/sns/instagram.png',
  mail:      '/sns/mail.png',
};
---

<div class:list={['social-links', `size-${size}`]}>
  {socials.map((s) => (
    <a
      href={s.url}
      target={s.url.startsWith('mailto') ? undefined : '_blank'}
      rel="noopener noreferrer"
      aria-label={s.label}
      title={s.label}
      class="social-link"
    >
      <img
        src={iconSrc[s.icon]}
        alt={s.label}
        class="icon"
        width="20"
        height="20"
        loading="lazy"
        decoding="async"
      />
      <span class="label">{s.label}</span>
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
    white-space: nowrap;
  }

  .social-link:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
    background: var(--canvas-subtle);
    text-decoration: none;
  }

  .icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 3px;
  }

  .size-sm .social-link {
    font-size: 0.8125rem;
    padding: 0.2rem 0.6rem;
    gap: 0.35rem;
  }

  .size-sm .icon {
    width: 16px;
    height: 16px;
  }
</style>
