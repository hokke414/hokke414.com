---
import { formatDate } from '../utils/content';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  endDate?: Date;
  type: 'community' | 'event' | 'oss' | 'hackathon' | 'other';
  organization?: string;
  role?: string;
  links?: { label: string; url: string }[];
  image?: string;
}

const { href, title, description, date, endDate, type, organization, role, links = [], image } = Astro.props;

const typeLabel: Record<Props['type'], string> = {
  community: 'コミュニティ',
  event: 'イベント',
  oss: 'OSS',
  hackathon: 'ハッカソン',
  other: 'その他',
};

const periodStr = endDate
  ? `${formatDate(date)} – ${formatDate(endDate)}`
  : formatDate(date);
---

<article class="card">
  <a href={href} class="card-inner">
    <img class="card-image" src={image || '/noimg.png'} alt="" loading="lazy" />
    <div class="card-body">
      <div class="card-label">
        <span class:list={['type-badge', `type-${type}`]}>{typeLabel[type]}</span>
        {organization && <span class="org-tag">{organization}</span>}
        <time class="date" datetime={date.toISOString()}>{periodStr}</time>
      </div>
      <h3 class="card-title">{title}</h3>
      {role && <p class="role">{role}</p>}
      <p class="card-desc">{description}</p>
    </div>
  </a>
  {links.length > 0 && (
    <div class="card-links">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer" class="ext-link">
          {l.label} ↗
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .card:hover { border-color: var(--accent); box-shadow: var(--shadow-sm); }

  .card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: inherit;
    text-decoration: none;
  }

  .card-inner:hover { text-decoration: none; }
  .card:hover .card-title { color: var(--accent); }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--canvas-subtle);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-links {
    margin: 0 1.25rem 1.25rem;
  }

  .card-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .type-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 2em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .type-community { background: #dbeafe; color: #1e40af; }
  .type-event     { background: #fce7f3; color: #9d174d; }
  .type-oss       { background: #dcfce7; color: #14532d; }
  .type-hackathon { background: #fef9c3; color: #713f12; }
  .type-other     { background: var(--canvas-subtle); color: var(--fg-muted); }

  .org-tag {
    font-size: 0.75rem;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 2em;
    padding: 0.1rem 0.55rem;
  }

  :root.dark .type-community { background: #1c2e4a; color: #93c5fd; }
  :root.dark .type-event     { background: #3b1728; color: #f9a8d4; }
  :root.dark .type-oss       { background: #14291e; color: #86efac; }
  :root.dark .type-hackathon { background: #2d2013; color: #fde047; }

  .date {
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: calc(1.4em * 2);
  }

  .role {
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .ext-link {
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
  }
</style>
