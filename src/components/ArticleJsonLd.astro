---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
}

const { title, description, pubDate, updatedDate, tags = [], image } = Astro.props;
const siteUrl = 'https://hokke414.com';
const absoluteImage = new URL(image || '/avatar.png', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: Astro.url.href,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'ja',
  keywords: tags.join(', ') || undefined,
  author: { '@id': `${siteUrl}/#person` },
  publisher: { '@id': `${siteUrl}/#person` },
  image: absoluteImage,
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
