---
interface Props {
  id: string;
  title: string;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  status?: 'active' | 'wip' | 'archived';
  featured?: boolean;
}

const { id, title, description, tags, github, demo, status = 'active', featured } = Astro.props;

const statusLabel = { active: null, wip: 'WIP', archived: 'Archived' } as const;
---

<article class="card" data-tags={tags.join(',')}>
  <div class="card-body">
    <div class="card-header">
      <h3 class="card-title">
        <a href={`/projects/${id}`}>{title}</a>
      </h3>
      <div class="badges">
        {featured && <span class="badge badge-featured">Featured</span>}
        {statusLabel[status] && <span class="badge badge-status">{statusLabel[status]}</span>}
      </div>
    </div>
    <p class="card-desc">{description}</p>
    <div class="card-tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
  <div class="card-links">
    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" class="link-btn">
        GitHub
      </a>
    )}
    {demo && (
      <a href={demo} target="_blank" rel="noopener noreferrer" class="link-btn">
        Demo
      </a>
    )}
    <a href={`/projects/${id}`} class="link-btn link-primary">詳細 →</a>
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color var(--transition), box-shadow var(--transition);
    overflow: hidden;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .card-body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .card-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .badges {
    display: flex;
    gap: 0.3rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 2em;
    white-space: nowrap;
  }

  .badge-featured { background: #fff8c5; color: #7d4e00; }
  :root.dark .badge-featured { background: #2d2013; color: #e3b341; }

  .badge-status { background: var(--canvas-subtle); color: var(--fg-muted); border: 1px solid var(--border); }

  .card-desc {
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .card-links {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--canvas-subtle);
    flex-wrap: wrap;
  }

  .link-btn {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.25rem 0.65rem;
    background: var(--canvas);
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .link-btn:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
    text-decoration: none;
  }

  .link-primary {
    color: var(--accent);
    border-color: var(--accent);
    margin-left: auto;
  }

  .link-primary:hover {
    background: var(--accent-subtle);
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
